\
\cf19 \cb18 char\cf20  \cf17 keyPressed;\cf21 \cb1 \
\cf19 \cb18 int\cf20  \cf17 count\cf22 =0\cf17 ;\
\cf21 \cb1 \

\f1\b \cf23 \cb18 while
\f0\b0 \cf20  \cf17 (keyPressed\cf20  \cf22 !=\cf20  \cf24 'x'\cf17 )\cf20  \cf17 \{\cf21 \cb1 \
\cf20 \cb18    \cf17 count\cf22 ++\cf17 ;\cf21 \cb1 \
\cf17 \cb18 \}\
\
