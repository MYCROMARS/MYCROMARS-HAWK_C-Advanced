typedef enum button \{ ON, OFF \} Button;\
\
Button press(Button current);\
\
void print_button(Button current);\
\
int main() \{\
	Button power = ON;		// 0\
\
	// Output\
	print_button(power);\
\
	// Assign: Function switch ON/OFF\
	power = press(power);\
\
	// Output\
	print_button(power);\
\
	// Assign: Function switch ON/OFF\
	power = press(power);\
\
	// Output\
	print_button(power);\
\
\
	return 0;\
\}\
\
// Function: switch ON/OFF\
Button press(Button current)\
\{\
	if (current == ON) return OFF;\
	else return ON;\
\}\
\
// Function: Output\
void print_button(Button current)\
\{\
	if (current == ON) printf(\'93ON\\n\'94);\
	else if (current == OFF) printf(\'93OFF\\\'94);\
\}\
